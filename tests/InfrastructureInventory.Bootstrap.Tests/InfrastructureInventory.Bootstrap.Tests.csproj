<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <StartupObject>Kordra.InfrastructureInventory.Bootstrap.Tests.WorkflowFixtureProgram</StartupObject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" PrivateAssets="all" />
    <PackageReference Include="xunit" Version="2.9.3" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../src/Host/Kordra.Api/Kordra.Api.csproj" />
    <ProjectReference Include="../../src/Modules/InfrastructureInventory/Kordra.Modules.InfrastructureInventory.csproj" />
    <ProjectReference Include="../../src/Modules/InfrastructureInventory/Contracts/Kordra.Modules.InfrastructureInventory.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup><Compile Include="../Shared/DisposablePostgreSqlProfile.cs" Link="Fixtures/DisposablePostgreSqlProfile.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/RegressionPostgreSqlSelection.cs" Link="Fixtures/RegressionPostgreSqlSelection.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/NomadTlsFixture.cs" Link="Fixtures/NomadTlsFixture.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Shared/KubernetesTlsFixture.cs" Link="Fixtures/KubernetesTlsFixture.cs" /></ItemGroup>
  <ItemGroup><None Update="Fixtures/workflow-transition-requested-v1.*" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup Condition="'$(T12CodegenBootstrap)' == 'true'"><Compile Remove="Internal/Generated/**/*.cs" /></ItemGroup>
  <ItemGroup><Compile Include="../Messaging.Tests/CommitReplyFault.cs" Link="Fixtures/CommitReplyFault.cs" /></ItemGroup>
</Project>
