{
  "openapi": "3.1.0",
  "info": {
    "title": "Kordra Kubernetes Workloads v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:5128"
    }
  ],
  "paths": {
    "/api/v1/targets/{targetId}/workloads": {
      "get": {
        "operationId": "ReadKubernetesWorkloads",
        "parameters": [
          {
            "in": "path",
            "name": "targetId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "localSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized, bounded workload facts; not health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KubernetesWorkloadsV1"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request shape"
          },
          "401": {
            "description": "No current session"
          },
          "403": {
            "description": "Denied/unconfigured target"
          },
          "503": {
            "description": "Unavailable; response may be aborted before headers"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-kordra.session"
      }
    },
    "schemas": {
      "KubernetesWorkloadsV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "invocationId",
          "targetId",
          "namespace",
          "capturedAtUtc",
          "completedAtUtc",
          "validUntilUtc",
          "coverage",
          "resourceSets"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "invocationId": {
            "type": "string",
            "format": "uuid"
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "namespace": {
            "type": "string",
            "maxLength": 63
          },
          "capturedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "completedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "validUntilUtc": {
            "type": "string",
            "format": "date-time"
          },
          "coverage": {
            "type": "string",
            "enum": [
              "complete",
              "partial"
            ]
          },
          "resourceSets": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/KubernetesResourceSetV1"
            },
            "minItems": 4
          }
        }
      },
      "KubernetesResourceSetV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "status",
          "coverage",
          "resourceVersion",
          "items"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "Pod",
              "Deployment",
              "StatefulSet",
              "DaemonSet"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "unavailable"
            ]
          },
          "coverage": {
            "type": "string",
            "enum": [
              "complete",
              "partial",
              "unavailable"
            ]
          },
          "resourceVersion": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "items": {
            "type": "array",
            "maxItems": 25,
            "items": {
              "$ref": "#/components/schemas/KubernetesWorkloadItemV1"
            }
          }
        }
      },
      "KubernetesWorkloadItemV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name",
          "uid",
          "generation",
          "observedGeneration",
          "desiredReplicas",
          "readyReplicas",
          "availableReplicas",
          "podPhase",
          "podReady",
          "images"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "Pod",
              "Deployment",
              "StatefulSet",
              "DaemonSet"
            ]
          },
          "name": {
            "type": "string",
            "maxLength": 253
          },
          "uid": {
            "type": "string",
            "maxLength": 128
          },
          "generation": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "observedGeneration": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "desiredReplicas": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 2147483647
          },
          "readyReplicas": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 2147483647
          },
          "availableReplicas": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 2147483647
          },
          "podPhase": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "Pending",
              "Running",
              "Succeeded",
              "Failed",
              "Unknown"
            ]
          },
          "podReady": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "images": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "#/components/schemas/KubernetesImageV1"
            }
          }
        }
      },
      "KubernetesImageV1": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "containerName",
          "reportedReference",
          "declaredDigest",
          "reportedRuntimeDigest"
        ],
        "properties": {
          "containerName": {
            "type": "string",
            "maxLength": 63
          },
          "reportedReference": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "declaredDigest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "reportedRuntimeDigest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  },
