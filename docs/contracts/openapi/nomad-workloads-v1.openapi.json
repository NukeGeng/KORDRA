{
  "openapi": "3.1.0",
  "info": {
    "title": "Kordra Nomad Workloads v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:5128"
    }
  ],
  "paths": {
    "/api/v1/targets/{targetId}/nomad-workloads": {
      "get": {
        "operationId": "ReadNomadWorkloads",
        "parameters": [
          {
            "in": "path",
            "name": "targetId",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "localSession": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current authorized, bounded workload facts; not health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NomadWorkloadsV1"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request shape"
          },
          "401": {
            "description": "No current session"
          },
          "403": {
            "description": "Denied/unconfigured target"
          },
          "503": {
            "description": "Unavailable; response may be aborted before headers"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "localSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-kordra.session"
      }
    },
    "schemas": {
      "NomadWorkloadsV1": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "invocationId": {
            "type": "string",
            "format": "uuid"
          },
          "targetId": {
            "type": "string",
            "format": "uuid"
          },
          "provider": {
            "const": "nomad"
          },
          "namespace": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "capturedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "completedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "validUntilUtc": {
            "type": "string",
            "format": "date-time"
          },
          "coverage": {
            "enum": [
              "complete",
              "partial"
            ]
          },
          "resourceSets": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "#/components/schemas/JobsSet"
              },
              {
                "$ref": "#/components/schemas/AllocationsSet"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "schemaVersion",
          "invocationId",
          "targetId",
          "provider",
          "namespace",
          "region",
          "capturedAtUtc",
          "completedAtUtc",
          "validUntilUtc",
          "coverage",
          "resourceSets"
        ]
      },
      "ResourceSet": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/JobsSet"
          },
          {
            "$ref": "#/components/schemas/AllocationsSet"
          }
        ]
      },
      "Job": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "service",
              "batch",
              "system",
              "sysbatch",
              null
            ]
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "dead",
              null
            ]
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "status"
        ]
      },
      "Allocation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "jobId": {
            "type": "string"
          },
          "taskGroup": {
            "type": "string"
          },
          "clientStatus": {
            "enum": [
              "pending",
              "running",
              "complete",
              "failed",
              "lost",
              "unknown",
              null
            ]
          },
          "desiredStatus": {
            "enum": [
              "run",
              "stop",
              "evict",
              null
            ]
          }
        },
        "required": [
          "id",
          "jobId",
          "taskGroup",
          "clientStatus",
          "desiredStatus"
        ]
      },
      "JobsSet": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "Jobs"
          },
          "status": {
            "enum": [
              "observed",
              "unavailable"
            ]
          },
          "coverage": {
            "enum": [
              "complete",
              "partial",
              "unavailable"
            ]
          },
          "observationIndex": {
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "type": "array",
            "maxItems": 25,
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          }
        },
        "required": [
          "kind",
          "status",
          "coverage",
          "observationIndex",
          "items"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unavailable"
                }
              }
            },
            "then": {
              "properties": {
                "coverage": {
                  "const": "unavailable"
                },
                "observationIndex": {
                  "type": "null"
                },
                "items": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "coverage": {
                  "enum": [
                    "complete",
                    "partial"
                  ]
                },
                "observationIndex": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$"
                }
              }
            }
          }
        ]
      },
      "AllocationsSet": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "Allocations"
          },
          "status": {
            "enum": [
              "observed",
              "unavailable"
            ]
          },
          "coverage": {
            "enum": [
              "complete",
              "partial",
              "unavailable"
            ]
          },
          "observationIndex": {
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "type": "array",
            "maxItems": 25,
            "items": {
              "$ref": "#/components/schemas/Allocation"
            }
          }
        },
        "required": [
          "kind",
          "status",
          "coverage",
          "observationIndex",
          "items"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unavailable"
                }
              }
            },
            "then": {
              "properties": {
                "coverage": {
                  "const": "unavailable"
                },
                "observationIndex": {
                  "type": "null"
                },
                "items": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "coverage": {
                  "enum": [
                    "complete",
                    "partial"
                  ]
                },
                "observationIndex": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,19}$"
                }
              }
            }
          }
        ]
      }
    }
  },
