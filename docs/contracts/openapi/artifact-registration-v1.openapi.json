  "components": {
    "securitySchemes": {
      "localSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-kordra.session"
      }
    },
    "schemas": {
      "Platform": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "os",
          "architecture",
          "variant"
        ],
        "properties": {
          "os": {
            "const": "linux"
          },
          "architecture": {
            "enum": [
              "amd64",
              "arm64"
            ]
          },
          "variant": {
            "anyOf": [
              {
                "const": "v8"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "oneOf": [
          {
            "properties": {
              "architecture": {
                "const": "amd64"
              },
              "variant": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "architecture": {
                "const": "arm64"
              },
              "variant": {
                "enum": [
                  null,
                  "v8"
                ]
              }
            }
          }
        ]
      },
      "SourceClaim": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceRepository",
          "sourceCommit",
          "buildRef"
        ],
        "properties": {
          "sourceRepository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^(?!/)(?!.*//)(?!.*\\/$)(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-z0-9._/-]{1,128}$"
          },
          "sourceCommit": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "buildRef": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9._-]{1,128}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "RegistrationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "correlationId",
          "registryId",
          "repository",
          "digest",
          "platform",
          "sourceClaim"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "correlationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "registryId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "repository": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[a-z0-9]+((\\.|_|__|-+)[a-z0-9]+)*(/[a-z0-9]+((\\.|_|__|-+)[a-z0-9]+)*)*$"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha(?:256:[0-9a-f]{64}|512:[0-9a-f]{128})$"
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "sourceClaim": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SourceClaim"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Artifact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifactId",
          "projectId",
          "registryId",
          "repository",
          "rootDigest",
          "platform",
          "rootMediaType",
          "rootSizeBytes",
          "selectedManifestDigest",
          "selectedManifestSizeBytes",
          "selectedManifestMediaType",
          "configDigest",
          "configSizeBytes",
          "observedPlatform",
          "variantEvidence",
          "verifierProfile",
          "verifiedAtUtc",
          "createdAtUtc",
          "contentVerification",
          "layerAvailability",
          "signatureVerification"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "projectId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "registryId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "repository": {
            "type": "string",
            "pattern": "^[a-z0-9]+((\\.|_|__|-+)[a-z0-9]+)*(/[a-z0-9]+((\\.|_|__|-+)[a-z0-9]+)*)*$"
          },
          "rootDigest": {
            "type": "string",
            "pattern": "^sha(?:256:[0-9a-f]{64}|512:[0-9a-f]{128})$"
          },
          "platform": {
            "$ref": "#/components/schemas/Platform"
          },
          "rootMediaType": {
            "type": "string"
          },
          "rootSizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "selectedManifestDigest": {
            "type": "string",
            "pattern": "^sha(?:256:[0-9a-f]{64}|512:[0-9a-f]{128})$"
          },
          "selectedManifestSizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "selectedManifestMediaType": {
            "type": "string"
          },
          "configDigest": {
            "type": "string",
            "pattern": "^sha(?:256:[0-9a-f]{64}|512:[0-9a-f]{128})$"
          },
          "configSizeBytes": {
            "type": "integer",
            "minimum": 1
          },
          "observedPlatform": {
            "$ref": "#/components/schemas/Platform"
          },
          "variantEvidence": {
            "enum": [
              "none",
              "config",
              "descriptor"
            ]
          },
          "verifierProfile": {
            "type": "string"
          },
          "verifiedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "contentVerification": {
            "type": "string"
          },
          "layerAvailability": {
            "type": "string"
          },
          "signatureVerification": {
            "type": "string"
          }
        }
      },
      "Registration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registrationId",
          "status",
          "createdAtUtc",
          "completedAtUtc",
          "attemptVerifiedAtUtc",
          "safeReason",
          "artifact",
          "sourceClaim",
          "provenance"
        ],
        "properties": {
          "registrationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^(?!00000000-0000-0000-0000-000000000000$)[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "status": {
            "enum": [
              "Pending",
              "Registered",
              "Failed",
              "Abandoned"
            ]
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "completedAtUtc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
